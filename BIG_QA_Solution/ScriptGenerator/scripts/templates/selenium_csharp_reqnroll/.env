# Environment configuration consumed by Utils/ConfigReader.cs (via DotNetEnv).
# APP_URL, USER and PASSWORD below are filled in at scaffold time from the modal form.
# BROWSER may be chrome | firefox | edge. HEADLESS is "true" or "false".
APP_URL={{BASE_URL}}
BROWSER=chrome
HEADLESS=false
USER={{USERNAME}}
PASSWORD={{PASSWORD}}
# CRED_KEY decrypts the AES-encrypted PASSWORD above.
CRED_KEY={{CRED_KEY}}
