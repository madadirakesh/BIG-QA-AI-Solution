# Environment configuration consumed by ConfigReader.java (via dotenv-java).
# {{BASE_URL}}, {{USERNAME}}, {{PASSWORD}} are substituted at scaffold time by
# BootstrapperEngine.generate_project using values from the modal form.
# BROWSER may be chrome | firefox | edge. HEADLESS is "true" or "false".
APP_URL={{BASE_URL}}
BROWSER=chrome
HEADLESS=false
USER={{USERNAME}}
PASSWORD={{PASSWORD}}
# CRED_KEY decrypts the AES-encrypted PASSWORD above.
CRED_KEY={{CRED_KEY}}
