# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to `.env` and edit for your local setup.
# ─────────────────────────────────────────────────────────────────────────────
# `.env`         — your local, real values; gitignored, NEVER commit.
# `.env.example` — this file; safe to commit. Documents which variables the
#                  project reads via ConfigReader.java (dotenv-java).
#
# The demo values below point at saucedemo.com so a fresh clone can run the
# sample login feature out of the box. Replace them with your actual targets.

# Base URL of the application under test (required by ConfigReader.getAppUrl()).
APP_URL=https://www.saucedemo.com

# chromium | firefox | webkit
BROWSER=chromium

# true to run without a visible browser (use this in CI).
HEADLESS=false

# Credentials consumed by step definitions / page objects.
USER=standard_user
PASSWORD=secret_sauce
