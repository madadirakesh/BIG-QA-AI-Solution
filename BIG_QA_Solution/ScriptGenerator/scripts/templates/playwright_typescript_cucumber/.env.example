# Copy to .env and fill in. The QA app writes a real .env when it generates this project;
# this file just documents the params for a manual setup.
APP_URL=https://example.com
BROWSER=chromium        # chromium | firefox | webkit
HEADLESS=false
USER=admin
PASSWORD=your_password
# CRED_KEY decrypts an AES-encrypted PASSWORD ("ENC:..."). Leave blank for a plaintext PASSWORD.
CRED_KEY=
