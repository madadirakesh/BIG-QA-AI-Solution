AI_TOOL=GEMINI
AI_MODEL=gemini-2.5-flash-lite
API_KEY=your-api-key-here
AI_PROVIDER=gemini
LOCAL_DB_NAME=local_database
CRED_ENC_KEY=your-encryption-key-here
FLASK_SECRET_KEY=your-flask-secret-key-here
APP_TIMEZONE=America/New_York

# ── Test Execution module (all optional) ─────────────────────────────────────
# Extra hosts the browser may open besides the run's base URL (comma separated, * wildcards allowed)
TEST_EXECUTION_ALLOWED_HOSTS=
# Hosts treated as production: runs against them need explicit confirmation in the UI
TEST_EXECUTION_PRODUCTION_HOSTS=
# Zephyr Scale Cloud (REST API v2). Can also be set from Test Execution > Configure Zephyr.
ZEPHYR_API_TOKEN=
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
# Pinned Playwright MCP package started with npx (Node.js 18+ required)
PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.83
# Where uploads, evidence and result workbooks are stored (default: workspace/test_execution)
TEST_EXECUTION_DATA_DIR=
# Absolute app URL used in screenshot hyperlinks inside result workbooks (e.g. http://qa-host:5000)
TEST_EXECUTION_PUBLIC_BASE_URL=
